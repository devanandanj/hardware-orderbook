[tasks]
bmc
prove
cover

[options]
bmc:   mode bmc
bmc:   depth 30
# Shallow: the timeline invariants in book.sv make the proof local.
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 60

[engines]
smtbmc bitwuzla

[script]
read -formal order_table.sv price_slot.sv price_book.sv book.sv book_formal.sv
prep -top book_formal

[files]
generated/itch_defs.vh
../rtl/book_pkg.sv
../rtl/order_table.sv
../rtl/price_slot.sv
../rtl/price_book.sv
../rtl/book.sv
book_formal.sv

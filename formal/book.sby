[tasks]
bmc
prove
cover

[options]
bmc:   mode bmc
bmc:   depth 10
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 16

[engines]
smtbmc boolector

[script]
read -formal book.sv
read -formal book_formal.sv
# A small book: the RTL is the same at any size, and k-induction closes fast.
chparam -set MAX 4 book_formal
prep -top book_formal

[files]
../rtl/book.sv
book_formal.sv
